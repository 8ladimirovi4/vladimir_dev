# Canonical public origin (no trailing slash).
# Local:   http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://serverIP:PORT

# --- Docker Compose (local / VPS .env — never commit real .env) ---
# Local: vladimir_dev:local (compose builds it). VPS/CD: Hub tag, e.g. vlleo/vladimir_dev:v1.0.0
WEB_IMAGE=vladimir_dev:local
SERVER_IP=serverIP
NGINX_HTTPS_PORT=PORT

# Search indexing:
# - omit / false on IP phase → noindex (recommended until DNS domain is live)
# - true after domain cutover → allow Google/Yandex
NEXT_PUBLIC_SITE_INDEXING=false

# =============================================================================
# GitHub Actions — NOT read from this file.
# Set in: Settings → Secrets and variables → Actions
# Workflows: .github/workflows/ci.yml, release.yml
# =============================================================================
#
# Repository Variables (vars.*):
#   CI_RUNNER_IMAGE=ubuntu-26.04
#   NGINX_HTTPS_PORT=8443
#   DOCKERHUB_REPO=vlleo/vladimir_dev  
#   GHCR_REPO=                      # optional; default = ghcr.io/<github.repository>
#
# Repository Secrets (secrets.*):
#   DOCKERHUB_USERNAME=vlleo
#   DOCKERHUB_TOKEN=
#   PROD_SITE_URL=https://YOUR.SERVER.IP:PORT
#   VPS_HOST=
#   VPS_USER=deploy
#   VPS_SSH_KEY=
#
# From GitHub context (not Secrets):
#   github.repository → owner/name (default Docker Hub + GHCR path)
#   github.ref_name → tag name, e.g. v1.0.0
#   GITHUB_TOKEN → provided by Actions automatically
