# Canonical public origin (no trailing slash).
# Phase 1 (IP + Let's Encrypt):  https://YOUR.SERVER.IP
# Phase 2 (domain):              https://your-domain.com
NEXT_PUBLIC_SITE_URL=https://YOUR.SERVER.IP

# Search indexing (also gates AI crawler rules in robots.txt):
# - omit / false → Disallow: / for everyone (IP / staging phase)
# - true → allow Google/Yandex + AI search bots; block AI training bots
#   (GPTBot, ClaudeBot, Google-Extended, Bytespider)
# NEXT_PUBLIC_SITE_INDEXING=true
