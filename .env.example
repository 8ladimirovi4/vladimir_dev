# cp .env.example .env

# Canonical origin (no trailing slash). Rebuild Docker image after change.
# Local:      http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

WEB_IMAGE=vladimir_dev:local
SERVER_IP=SERVER_IP
NEXT_PUBLIC_SITE_INDEXING=false

# Optional. Host port for HTTPS → nginx :443. Default 443 if unset.
# NGINX_HTTPS_PORT=8443
