# Dependencies (installed in the image via npm ci)
node_modules

# Git — history and metadata not needed in build context
.git

# Logs and runtime output
logs/
*.log

# Secrets and local env (must not ship in the image or build context)
.env
.env.*
!.env.example

# Next.js build artifacts (produced in Dockerfile)
.next/
out/

# Editor and IDE settings
.vscode/
.idea/
.cursor/

# Local / internal docs (not part of the runtime image)
dev/
development_docs

# Docker / compose (not needed inside the image build context)
Dockerfile*
docker-compose*.yml
compose*.yaml
deploy/

# Misc
README.md
*.md
.github/
